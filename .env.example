# ─────────────────────────────────────────────────────────────────────────────
# EdgeLink — SEO Intelligence · environment template
# Copy to `.env` for local development:  cp .env.example .env
# Never commit `.env`. Values below are safe local placeholders only.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Public origin used for absolute links in reports/notifications.
APP_URL=http://localhost:3000
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────────────────────
# 32+ random chars: `openssl rand -base64 32`. Signs the HttpOnly session JWT.
AUTH_SECRET=replace-me-with-a-long-random-string-min-32-chars

# Shared secret for the cron-job.org trigger. Required by POST /api/cron/schedules.
CRON_SECRET=replace-me-with-a-second-long-random-string

# ── Database (PostgreSQL on Supabase or Neon) ────────────────────────────────
# Supabase pooler URL for runtime, direct URL for `prisma db push`/migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edgelink?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/edgelink?schema=public

# ── Redis (Upstash) ──────────────────────────────────────────────────────────
# Upstash gives a rediss:// URL; plain redis:// is fine locally.
REDIS_URL=redis://localhost:6379

# ── Mock integrations ────────────────────────────────────────────────────────
# true  → deterministic assessment fixtures for PageSpeed, GSC, DataForSEO, WhatsApp.
# false → real adapters where implemented; missing credentials raise a clear error.
USE_MOCKS=true

# AI analysis. Keep true for demos/tests that must not spend tokens.
# false requires ANTHROPIC_API_KEY; failures are persisted, never faked.
AI_USE_MOCKS=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Only needed when USE_MOCKS=false (live PageSpeed Insights).
PAGESPEED_API_KEY=

# ── Reports ──────────────────────────────────────────────────────────────────
# local  → writes PDFs under REPORT_DIR (development / single-host deployments)
# Replaceable adapter: see src/report/storage.ts to plug S3/R2/Supabase Storage.
REPORT_STORAGE=local
REPORT_DIR=.data/reports
# Optional explicit Chrome/Chromium for Puppeteer. Autodetected when empty.
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_HEADLESS=true

# ── Email notifications ──────────────────────────────────────────────────────
# mock → records the intended delivery in the database as MOCKED (nothing is sent)
# smtp → real delivery through nodemailer using the SMTP_* values
EMAIL_TRANSPORT=mock
EMAIL_FROM="EdgeLink Reports <reports@edgelink.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── WhatsApp (Twilio) ────────────────────────────────────────────────────────
# Only used when USE_MOCKS=false. Mock mode always uses src/mocks/twilio.mock.js.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
AUDIT_TIMEOUT_MS=45000
