// EdgeLink — SEO Intelligence
// Relational schema for the audit platform (PostgreSQL / Supabase / Neon).
//
// PROVENANCE: the assessment's own Prisma schema was not included in the supplied
// document, so this is an original design (documented in README → Data model).
// It is intentionally extensible: raw signals and validated AI output are stored as
// JSON so new checks/fields do not require migrations, while ownership, status and
// reporting metadata are first-class typed columns with indexes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum WebsiteStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AuditStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AuditTrigger {
  MANUAL
  SCHEDULED
  RETRY
}

enum AiSource {
  CLAUDE
  MOCK
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  SENT
  MOCKED
  FAILED
}

enum ScheduleFrequency {
  MONTHLY
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(CLIENT)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  client           Client?   @relation("ClientMembers", fields: [clientId], references: [id], onDelete: SetNull)
  clientId         String?
  requestedAudits  Audit[]   @relation("AuditRequester")
  createdSchedules AuditSchedule[] @relation("ScheduleCreator")

  @@index([clientId])
  @@map("users")
}

model Client {
  id           String   @id @default(cuid())
  name         String
  company      String?
  contactEmail String?
  phone        String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users     User[]     @relation("ClientMembers")
  websites  Website[]
  audits    Audit[]

  @@index([name])
  @@map("clients")
}

model Website {
  id           String        @id @default(cuid())
  clientId     String
  url          String
  label        String?
  businessType String
  city         String
  state        String
  country      String        @default("India")
  status       WebsiteStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  audits    Audit[]
  schedule  AuditSchedule?

  @@unique([clientId, url])
  @@index([clientId])
  @@map("websites")
}

model Audit {
  id            String       @id @default(cuid())
  websiteId     String
  clientId      String
  status        AuditStatus  @default(QUEUED)
  trigger       AuditTrigger @default(MANUAL)
  stage         String       @default("queued")
  progress      Int          @default(0)
  jobId         String?
  requestedById String?
  attempt       Int          @default(1)
  queuedAt      DateTime     @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?
  error         String?

  // Raw crawl + mocked integration signals (typed shape in src/types/audit.ts)
  signals       Json?
  // Validated AI analysis (Zod-checked against analyseResponseSchema)
  aiResult      Json?
  aiSource      AiSource?
  aiModel       String?
  aiLatencyMs   Int?
  signalSources Json?
  overallScore  Int?
  scoreBreakdown Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website     Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedBy User?              @relation("AuditRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  events      AuditEvent[]
  report      Report?
  notifications NotificationAttempt[]
  schedules   AuditSchedule[]

  @@index([websiteId, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([status])
  @@index([queuedAt])
  @@map("audits")
}

model AuditEvent {
  id        String   @id @default(cuid())
  auditId   String
  stage     String
  status    String
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId, createdAt])
  @@map("audit_events")
}

model Report {
  id          String   @id @default(cuid())
  auditId     String   @unique
  storageKey  String
  filename    String
  mimeType    String   @default("application/pdf")
  sizeBytes   Int
  generatedAt DateTime @default(now())

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model NotificationAttempt {
  id         String              @id @default(cuid())
  auditId    String
  channel    NotificationChannel
  status     NotificationStatus
  recipient  String?
  providerId String?
  error      String?
  payload    Json?
  createdAt  DateTime            @default(now())

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId, createdAt])
  @@map("notification_attempts")
}

model AuditSchedule {
  id          String            @id @default(cuid())
  websiteId   String            @unique
  frequency   ScheduleFrequency @default(MONTHLY)
  dayOfMonth  Int               @default(1)
  hourUtc     Int               @default(3)
  timeZone    String            @default("Asia/Kolkata")
  isEnabled   Boolean           @default(true)
  nextRunAt   DateTime
  lastRunAt   DateTime?
  lastAuditId String?
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("ScheduleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastAudit Audit?   @relation(fields: [lastAuditId], references: [id], onDelete: SetNull)

  @@index([isEnabled, nextRunAt])
  @@map("audit_schedules")
}
